NARRATION_REFERENCE_AUDIO=voice_samples/reference.wav
NARRATION_POST_HTML_FILE=sample.html
NARRATION_QUOTE_MODE=preserve
NARRATION_DELIVERY=warm
NARRATION_SPEED=1.0
OMNIVOICE_URL=https://YOUR-COLAB-SESSION.gradio.live
# Exact transcript of this 3-10 second reference recording; required by default.
OMNIVOICE_REFERENCE_TEXT=
OMNIVOICE_QUOTE_REFERENCE_TEXT=
# Optional process environment: OMNIVOICE_TIMEOUT_SECONDS=180
# Bump when replacing the model behind an unchanged URL:
OMNIVOICE_MODEL_REVISION=colab-test-v1

NARRATION_ENGINE=gradio
NARRATION_VERIFY_TEXT=auto
# Upgraded Colab/native: use required verification.
# AWS: mount a SHA-256 keyed transcript manifest:
# OMNIVOICE_REFERENCE_MANIFEST=/config/voice-transcripts.json
# Native GPU: OMNIVOICE_MODEL_REVISION must resolve to the intended HF model commit.
